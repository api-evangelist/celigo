{
  "opencollection": "1.0.0",
  "info": {
    "name": "Celigo integrator.io Platform REST Connections State API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "State",
        "type": "folder"
      },
      "items": [
